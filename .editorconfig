# Shared editor settings
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Python and URScript: 4 spaces
[*.{py,script}]
indent_style = space
indent_size = 4

# RAPID: tabs, as in RobotStudio
[*.{mod,modx,sys,sysx}]
indent_style = tab

# Markdown: two trailing spaces are a line break
[*.md]
trim_trailing_whitespace = false
